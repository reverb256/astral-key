# =============================================================================
# Astral Key — Example Environment File
# =============================================================================
# Copy this file to .env and adjust for your environment.
#
#   cp .env.example .env
#   docker compose up -d
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8080

# ── Database (SQLite) ────────────────────────────────────────────────────────
# DATABASE_URL=sqlite:astral_key.db?mode=rwc
# DATABASE_MAX_CONNECTIONS=5

# ── JWT ──────────────────────────────────────────────────────────────────────
# REQUIRED. Generate with: openssl rand -hex 32
# JWT_SECRET=your-256-bit-hex-secret-here

# ── FIDO2 / WebAuthn ────────────────────────────────────────────────────────
# FIDO2_RP_ID=localhost
# FIDO2_RP_NAME=Astral Key
# FIDO2_ORIGINS=http://localhost:8080
# FIDO2_ATTESTATION=indirect

# ── Web3 / SIWE ──────────────────────────────────────────────────────────────
# ASTRAL_WEB3_DOMAIN=maplespike.ca

# ── OAuth (Optional — only set to enable GitHub OAuth) ──────────────────────
# OAUTH_BASE_URL=http://localhost:8080
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_REDIRECT_URI=http://localhost:8080/auth/oauth/github/callback

# ── JIT capability tokens (Optional — only set to enable JIT minting) ───────
# JIT_ISSUER_KEY=your-64-hex-char-ed25519-private-key   # openssl rand -hex 32
# JIT_ISSUER_ID=ak:issuer:01
# JIT_DEFAULT_TTL=3600

# ── Logging ──────────────────────────────────────────────────────────────────
# RUST_LOG=info,astral_key=debug
