# Astral Key — Local Development Environment Variables
#
# Copy to `.env` (do not commit) and fill in the required values.
# Required: JWT_SECRET (≥32 bytes) — astral-key refuses to start without one.

# ── Required ──────────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32

# Optional file-based path (overrides JWT_SECRET if set).
# File contents must be ≥32 bytes. Use this for production deployments so
# the secret never lives in `.env`.
# JWT_SECRET_FILE=/var/lib/astral-key/jwt_secret

# ── Server ────────────────────────────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://astral:astral@localhost:5432/astral_key
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=10

# ── Vaultwarden ───────────────────────────────────────────────────────────
VAULTWARDEN_URL=http://localhost:8000
# VAULTWARDEN_ADMIN_TOKEN_FILE=/var/lib/astral-key/vaultwarden_admin_token

# ── FIDO2 / WebAuthn ──────────────────────────────────────────────────────
FIDO2_RP_ID=localhost
FIDO2_RP_NAME=Astral Key
FIDO2_ORIGINS=http://localhost:8080,http://localhost:4321
FIDO2_ATTESTATION=indirect

# ── OIDC ─────────────────────────────────────────────────────────────────
OIDC_ISSUER_URL=https://auth.lan

# ── Logging ───────────────────────────────────────────────────────────────
RUST_LOG=info,astral_key=debug
