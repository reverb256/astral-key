# Astral Key - Ultra-minimal Passkey + Web3 (SIWE) Auth Sidecar
#
# Required:
JWT_SECRET=your-256-bit-hex-secret-here   # Generate: openssl rand -hex 32 (min 32 bytes)

# Optional (defaults shown):
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8080
# DATABASE_URL=sqlite:astral_key.db?mode=rwc
# DATABASE_MAX_CONNECTIONS=5
# FIDO2_RP_ID=localhost
# FIDO2_RP_NAME=Astral Key
# FIDO2_ORIGINS=http://localhost:8080
# FIDO2_ATTESTATION=indirect
# RUST_LOG=info,astral_key=debug
